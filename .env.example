WEB_PORT=8080
NODE_ENV=production
POSTGRES_DB=middle_workbench
POSTGRES_USER=middle_workbench
POSTGRES_PASSWORD=please-change-this-password
SESSION_SECRET=please-change-this-to-a-long-random-string
# Optional dedicated credential encryption key. If empty, SESSION_SECRET is used.
MODEL_PROVIDER_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Comma-separated optional business modules under server/src/modules.
ENABLED_MODULES=video-search
PANSOU_BASE_URL=https://pansou.top
VIDEO_SEARCH_TIMEOUT_MS=12000
VIDEO_SEARCH_MAX_RESULTS=100
VIDEO_SEARCH_RESOLVE_CACHE_TTL_MS=300000
