# The deploy script creates .env with random secrets on first run.
IMAGE_TAG=latest
WEB_PORT=8080
NODE_ENV=production
POSTGRES_DB=oa_workbench
POSTGRES_USER=oa_workbench
POSTGRES_PASSWORD=replace-with-a-strong-database-password
SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-characters
# Optional dedicated encryption key for model-provider API keys. Keep it stable after providers are created.
MODEL_PROVIDER_ENCRYPTION_KEY=
# Set true only after HTTPS is terminated before this service.
COOKIE_SECURE=false
ENABLED_MODULES=video-search
PANSOU_BASE_URL=https://pansou.top
VIDEO_SEARCH_TIMEOUT_MS=30000
VIDEO_SEARCH_MAX_RESULTS=100
VIDEO_SEARCH_RESOLVE_CACHE_TTL_MS=300000
